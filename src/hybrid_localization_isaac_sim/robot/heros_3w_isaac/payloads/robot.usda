#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.2"
    }
    defaultPrim = "innok_heros_3w_isaac_stable"
    doc = """Generated from Composed Stage of root layer /tmp/tmpx2d1bamc/innok_heros_3w_isaac_stable.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_heros_3w_isaac_s1faztr5/usdex_heros_3w_isaac/innok_heros_3w_isaac_stable.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_heros_3w_isaac_s1faztr5/temp_heros_3w_isaac/heros_3w_isaac.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "innok_heros_3w_isaac_stable" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </innok_heros_3w_isaac_stable/Physics/joint_base_wheel_rear_left>,
        </innok_heros_3w_isaac_stable/Physics/joint_base_wheel_rear_right>,
        </innok_heros_3w_isaac_stable/Physics/caster_bot_joint>,
        </innok_heros_3w_isaac_stable/Physics/caster_wheel_joint>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </innok_heros_3w_isaac_stable/Geometry/base_link>,
        </innok_heros_3w_isaac_stable/Geometry/base_link/wheel_rear_left>,
        </innok_heros_3w_isaac_stable/Geometry/base_link/wheel_rear_right>,
        </innok_heros_3w_isaac_stable/Geometry/base_link/caster_bot>,
        </innok_heros_3w_isaac_stable/Geometry/base_link/caster_bot/caster_wheel>,
    ]
    token isaac:robotType = "Wheeled"

    over "Geometry"
    {
        over "base_link" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "wheel_rear_left" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "wheel_rear_right" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "caster_bot" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "caster_wheel" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }
            }

            over "base_scan" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
            }
        }
    }

    over "Physics"
    {
        over "joint_base_wheel_rear_left" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint_base_wheel_rear_right" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "caster_bot_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "caster_wheel_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }
}

